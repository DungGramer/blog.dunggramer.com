---
import { type CollectionEntry } from "astro:content";
import BlogPost from "../../../layouts/BlogPost.astro";
import { getPostDetail } from "../../../services/post";
import { getPosts } from "../../../services/posts";
import generateStaticPaths from "../../../utils/getStaticPaths";

export async function getStaticPaths() {
  return generateStaticPaths(async (lang, paths) => {
    const posts = (await getPosts({ language: lang }))?.posts?.nodes;

    if (posts) {
      for (const post of posts) {
        paths.push({
          params: { lang: lang.toLocaleLowerCase(), slug: post.slug },
        });
      }
    }
  });
}
type Props = CollectionEntry<"blog">;

const { slug, lang } = Astro.params;
const response = await getPostDetail({
  id: slug,
  language: (lang || "").toLocaleUpperCase(),
  idType: "SLUG",
});
console.log(`📕 response - 29:[...slug].astro \n`, response);
const { title, content } = response?.post?.translation || {};
---

<BlogPost
  language={lang}
  title={title!}
  description=''
  pubDate={response?.post?.date!}
>
  <!-- {content} -->
  <div set:html={content} />
</BlogPost>
